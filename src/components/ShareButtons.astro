---
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const e = encodeURIComponent;
const wa = `https://wa.me/?text=${e(title + ' ' + url)}`;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`;
const tw = `https://twitter.com/intent/tweet?url=${e(url)}&text=${e(title)}`;
const tg = `https://t.me/share/url?url=${e(url)}&text=${e(title)}`;
---

<div class="share" data-share-url={url} data-share-title={title}>
  <span class="share__label">Compartilhe:</span>
  <div class="share__btns">
    <a class="share__btn share__btn--wa" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
    </a>
    <a class="share__btn share__btn--fb" href={fb} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no Facebook">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    <a class="share__btn share__btn--x" href={tw} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no X">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <a class="share__btn share__btn--tg" href={tg} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no Telegram">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
    </a>
    <button class="share__btn share__btn--copy" type="button" aria-label="Copiar link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <span class="share__copied" hidden>Copiado!</span>
    </button>
  </div>
</div>

<style>
  .share { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0; }
  .share__label { font-size: 0.85rem; font-weight: 700; color: var(--color-text-soft); }
  .share__btns { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .share__btn {
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%;
    color: #fff; border: none; cursor: pointer;
    transition: transform 0.12s, filter 0.12s;
  }
  .share__btn svg { width: 19px; height: 19px; }
  .share__btn:hover { transform: translateY(-2px); filter: brightness(1.05); }
  .share__btn--wa { background: #25D366; }
  .share__btn--fb { background: #1877F2; }
  .share__btn--x  { background: #000000; }
  .share__btn--tg { background: #229ED9; }
  .share__btn--copy { background: var(--color-dark); position: relative; }
  .share__copied {
    position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%);
    background: var(--color-dark); color: #fff; font-size: 0.7rem; font-weight: 700;
    padding: 0.2rem 0.5rem; border-radius: 6px; white-space: nowrap;
  }
</style>

<script>
  document.querySelectorAll('.share').forEach((box) => {
    const url = box.getAttribute('data-share-url') || location.href;
    const title = box.getAttribute('data-share-title') || document.title;
    const copyBtn = box.querySelector('.share__btn--copy');
    const copied = box.querySelector('.share__copied');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        // Web Share API (celular): abre o menu nativo de compartilhamento
        if (navigator.share) {
          try { await navigator.share({ title, url }); return; } catch (_) {}
        }
        try {
          await navigator.clipboard.writeText(url);
          if (copied) { copied.hidden = false; setTimeout(() => (copied.hidden = true), 1500); }
        } catch (_) {}
      });
    }
  });
</script>
