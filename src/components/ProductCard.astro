---
import AffiliateButton from './AffiliateButton.astro';
import ProsCons from './ProsCons.astro';

type Store = 'amazon' | 'petz' | 'petlove';

interface StoreLink {
  store: Store;
  url: string;
}

interface Props {
  name: string;
  brand?: string;
  rating?: number;
  price?: number;
  stores?: StoreLink[];
  affiliateUrl?: string;
  image?: string;
  pros?: string[];
  cons?: string[];
  rank?: number;
  source?: string;
}

const { name, brand, rating, price, stores, affiliateUrl, image, pros, cons, rank, source } =
  Astro.props;

// Normaliza para uma lista de lojas (retrocompat: affiliateUrl único = Amazon).
const storeLinks: StoreLink[] =
  stores && stores.length > 0
    ? stores
    : affiliateUrl
      ? [{ store: 'amazon', url: affiliateUrl }]
      : [];

const priceFmt = price
  ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(price)
  : null;

const stars = rating ? '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating)) : null;
---

<article class="product-card">
  {rank && <div class="product-card__rank">#{rank}</div>}
  <div class="product-card__media">
    {
      image ? (
        <img src={image} alt={name} loading="lazy" width="320" height="320" />
      ) : (
        <div class="product-card__placeholder" aria-hidden="true">
          🐾
        </div>
      )
    }
  </div>
  <div class="product-card__body">
    <header>
      {brand && <p class="product-card__brand">{brand}</p>}
      <h3 class="product-card__name">{name}</h3>
      {
        rating && (
          <p class="product-card__rating" aria-label={`Nota ${rating} de 5`}>
            <span class="stars" aria-hidden="true">
              {stars}
            </span>
            <span>{rating.toFixed(1)}</span>
          </p>
        )
      }
      {
        priceFmt ? (
          <p class="product-card__price">A partir de <strong>{priceFmt}</strong></p>
        ) : (
          <p class="product-card__price product-card__price--muted">Confira o preço atualizado na loja</p>
        )
      }
    </header>
    <slot />
    {(pros || cons) && <ProsCons pros={pros} cons={cons} />}
    <div class="product-card__actions">
      {storeLinks.map((s) => (
        <AffiliateButton href={s.url} store={s.store} source={source} block />
      ))}
    </div>
  </div>
</article>
