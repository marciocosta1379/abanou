---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { ANIMALS } from '../config/animals';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allPosts.filter((p) => p.data.featured).slice(0, 3);
const latest = allPosts.slice(0, 6);

const categories = [
  { slug: 'racao', label: 'Ração', icon: '🥩' },
  { slug: 'petiscos', label: 'Petiscos', icon: '🦴' },
  { slug: 'alimentadores', label: 'Comedouros & Bebedouros', icon: '🍽️' },
  { slug: 'tecnologia-pet', label: 'Tecnologia Pet', icon: '📡' },
  { slug: 'passeio', label: 'Passeio', icon: '🦮' },
  { slug: 'conforto', label: 'Conforto & Descanso', icon: '🛏️' },
  { slug: 'higiene', label: 'Higiene', icon: '🧼' },
  { slug: 'brinquedos', label: 'Brinquedos', icon: '🧸' },
  { slug: 'plano-de-saude', label: 'Plano de Saúde', icon: '❤️' },
  { slug: 'saude-cuidados', label: 'Saúde & Cuidados', icon: '💊' },
  { slug: 'aquarismo', label: 'Aquarismo', icon: '🐠' },
  { slug: 'guias', label: 'Guias de Compra', icon: '📖' },
];

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  fullTitle="Abanou: reviews e guias de compra para cães, gatos e aquário"
  description="Reviews honestos e comparativos de produtos para cães, gatos e aquarismo: ração, higiene, saúde, passeio e conforto, com o que vale a pena e o que não vale."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__decor" aria-hidden="true">
      <svg class="paw paw--1" viewBox="0 0 64 64" fill="currentColor"><ellipse cx="20" cy="22" rx="7" ry="9"/><ellipse cx="44" cy="22" rx="7" ry="9"/><ellipse cx="10" cy="40" rx="6" ry="8"/><ellipse cx="54" cy="40" rx="6" ry="8"/><path d="M32 34c9 0 16 6 16 13 0 6-7 9-16 9s-16-3-16-9c0-7 7-13 16-13z"/></svg>
      <svg class="paw paw--2" viewBox="0 0 64 64" fill="currentColor"><ellipse cx="20" cy="22" rx="7" ry="9"/><ellipse cx="44" cy="22" rx="7" ry="9"/><ellipse cx="10" cy="40" rx="6" ry="8"/><ellipse cx="54" cy="40" rx="6" ry="8"/><path d="M32 34c9 0 16 6 16 13 0 6-7 9-16 9s-16-3-16-9c0-7 7-13 16-13z"/></svg>
      <svg class="paw paw--3" viewBox="0 0 64 64" fill="currentColor"><ellipse cx="20" cy="22" rx="7" ry="9"/><ellipse cx="44" cy="22" rx="7" ry="9"/><ellipse cx="10" cy="40" rx="6" ry="8"/><ellipse cx="54" cy="40" rx="6" ry="8"/><path d="M32 34c9 0 16 6 16 13 0 6-7 9-16 9s-16-3-16-9c0-7 7-13 16-13z"/></svg>
      <svg class="paw paw--4" viewBox="0 0 64 64" fill="currentColor"><ellipse cx="20" cy="22" rx="7" ry="9"/><ellipse cx="44" cy="22" rx="7" ry="9"/><ellipse cx="10" cy="40" rx="6" ry="8"/><ellipse cx="54" cy="40" rx="6" ry="8"/><path d="M32 34c9 0 16 6 16 13 0 6-7 9-16 9s-16-3-16-9c0-7 7-13 16-13z"/></svg>
    </div>
    <div class="hero__inner">
      <div class="hero__content">
        <span class="hero__tagline">🐾 Testamos · Comparamos · Aprovamos</span>
        <h1>
          As melhores escolhas para o seu <em>Pet</em>
        </h1>
        <p class="hero__sub">
          Reviews honestos, comparativos detalhados e guias de compra para tutores.
          Do comedouro automático à melhor ração — só indicamos o que leva o selo
          ✅ Abanou. Sem enrolação.
        </p>
        <div class="hero__actions">
          <a href="/categorias/" class="btn btn--primary">
            Explorar categorias
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/sobre/" class="btn btn--soft">Como avaliamos</a>
        </div>
      </div>
      <div class="hero__visual">
        <img class="hero__seal" src="/images/selo-abanou.png" alt="Selo Aprovado pelo Abanou" width="300" height="300" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="trust-bar__inner">
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Reviews imparciais
      </span>
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
        Melhor custo-benefício
      </span>
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Atualizado regularmente
      </span>
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Só indicamos o que vale
      </span>
    </div>
  </div>

  <!-- NAVEGAR POR PET -->
  <div class="categories-strip categories-strip--pet">
    <div class="categories-strip__inner">
      <h2>Navegar por pet</h2>
      <ul class="cat-list cat-list--pet">
        {ANIMALS.map((a) => (
          <li>
            <a href={`/para/${a.slug}/`}>
              <span>{a.emoji}</span>
              {a.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- CATEGORIES -->
  <div class="categories-strip">
    <div class="categories-strip__inner">
      <h2>Navegar por categoria</h2>
      <ul class="cat-list">
        {categories.map((cat) => (
          <li>
            <a href={`/categorias/`}>
              <span>{cat.icon}</span>
              {cat.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- POSTS EM DESTAQUE -->
  {featured.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <h2>⭐ Em destaque</h2>
        <a href="/categorias/">Ver todos →</a>
      </div>
      <div class="post-grid">
        {featured.map((post) => {
          const thumb = post.data.products?.[0]?.image;
          return (
          <article class="post-card">
            <div class="post-card__thumb">
              {thumb
                ? <img src={thumb} alt={post.data.title} loading="lazy" width="320" height="240" />
                : <span>🐾</span>
              }
            </div>
            <div class="post-card__body">
              <span class="badge badge--orange">{post.data.category}</span>
              <a href={`/posts/${post.slug}/`} class="post-card__link">
                <h3>{post.data.title}</h3>
              </a>
              <p class="post-card__excerpt">{post.data.description}</p>
              <div class="post-card__footer">
                <span class="post-card__date">{formatDate(post.data.pubDate)}</span>
                <a href={`/posts/${post.slug}/`} class="post-card__read">Ler review →</a>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- POSTS RECENTES -->
  <section class="container section" style="padding-top: 0">
    <div class="section-header">
      <h2>Publicações recentes</h2>
      {latest.length > 0 && <a href="/categorias/">Ver todos →</a>}
    </div>

    {latest.length === 0 ? (
      <div class="post-grid">
        <div class="empty-state">
          <div class="empty-state__icon">🐾</div>
          <p>Em breve os primeiros reviews. Estamos preparando conteúdo de qualidade para você!</p>
        </div>
      </div>
    ) : (
      <div class="post-grid">
        {latest.map((post) => {
          const thumb = post.data.products?.[0]?.image;
          return (
          <article class="post-card">
            <div class="post-card__thumb">
              {thumb
                ? <img src={thumb} alt={post.data.title} loading="lazy" width="320" height="240" />
                : <span>🐾</span>
              }
            </div>
            <div class="post-card__body">
              <span class="badge">{post.data.category}</span>
              <a href={`/posts/${post.slug}/`} class="post-card__link">
                <h3>{post.data.title}</h3>
              </a>
              <p class="post-card__excerpt">{post.data.description}</p>
              <div class="post-card__footer">
                <span class="post-card__date">{formatDate(post.data.pubDate)}</span>
                <a href={`/posts/${post.slug}/`} class="post-card__read">Ler review →</a>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- POR QUE NOS -->
  <section class="why-section">
    <div class="container">
      <div class="why-section__head">
        <span class="why-eyebrow">🐾 Sobre nós</span>
        <h2>Por que confiar nos nossos reviews?</h2>
        <p>Não escrevemos de achismos. Cada recomendação é fundamentada em pesquisa séria antes de virar review.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-card__icon why-card__icon--orange">🔍</div>
          <h3>Pesquisa Cruzada</h3>
          <p>Cruzamos specs oficiais, avaliações de tutores e reclamações antes de indicar.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon why-card__icon--teal">🐕</div>
          <h3>Indicação por Perfil</h3>
          <p>Comparamos opções para cada porte, idade e necessidade do seu Pet.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon why-card__icon--orange">💰</div>
          <h3>Custo-Benefício Real</h3>
          <p>Levamos em conta o que o tutor e o pet realmente precisam no dia a dia.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon why-card__icon--teal">✅</div>
          <h3>Selo Abanou</h3>
          <p>Só recebe nosso selo o produto que passa por todo o crivo de pesquisa.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Faixa "Navegar por pet" — leve destaque sobre a de categorias */
  .categories-strip--pet { background: var(--color-teal-light); }
  .cat-list--pet a { font-weight: 700; }
  .cat-list--pet span { font-size: 1.15rem; }
</style>
