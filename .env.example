# Hostinger FTP — encontre em hPanel > Arquivos > Contas FTP
HOSTINGER_FTP_HOST=ftp.abanou.com.br
HOSTINGER_FTP_USER=u123456789
HOSTINGER_FTP_PASS=
HOSTINGER_FTP_DIR=/public_html

# Amazon Associados — sua tag de associado (ex.: abanou-20)
AMAZON_AFFILIATE_TAG=abanou-20

# Parceiro Petz — link/cupom do programa Parceiro Petz
PETZ_AFFILIATE_LINK=

# PetLove — link de afiliado aprovado (programa PetLove Saúde / produtos)
PETLOVE_AFFILIATE_LINK=
